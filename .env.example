# Copy this file to `.env.local` and fill in the two values.
# Find both in the Supabase dashboard: Settings -> API Keys.
#
# `.env.local` is gitignored. This template is committed on purpose.

# Supabase -> Settings -> API Keys -> Project URL
#
# The BARE ORIGIN, with no path. Supabase's Connect dialog also shows a REST
# endpoint ending in `/rest/v1/` — do not paste that one. supabase-js and the
# keep-alive workflow each append their own path, so a trailing `/rest/v1/`
# yields a doubled path and fails with:
#   404 PGRST125 "Invalid path specified in request URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Settings -> API Keys -> publishable key (starts with `sb_publishable_`)
#
# Older tutorials call this the "anon key" (a long eyJ... JWT). Supabase renamed
# these keys; the legacy anon key still works and goes in this same slot, but new
# projects should use the publishable key. Legacy keys are deprecated end of 2026.
#
# Safe to expose: NEXT_PUBLIC_* values are compiled into the browser bundle, and
# the publishable key is designed for that. Row Level Security is what protects
# data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---------------------------------------------------------------------------
# SEED SCRIPT ONLY — required by `npm run seed`, unused by the app itself.
#
# Supabase -> Settings -> API Keys -> secret key (`sb_secret_...`).
#
# This BYPASSES Row Level Security completely. It is needed because seeding
# creates auth users, which public.users foreign-keys to, and no public
# endpoint can do that. See docs/notes.md AD-12.
#
# Rules:
#   * Put the real value in `.env.local` only. Never here, never committed.
#   * Read by scripts/seed.mjs and nothing else. Never imported by app code.
#   * Note the absent NEXT_PUBLIC_ prefix. Next.js only inlines NEXT_PUBLIC_*
#     into the browser bundle, so even an accidental import into a Client
#     Component yields undefined in the browser instead of shipping the key.
#     The naming is a safeguard, not a convention.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# NEVER put these in this file or any committed file:
#   - the database password (shown once when the project is created)
#   - the secret key (`sb_secret_...`) / legacy service_role key
# Both bypass Row Level Security. This repository is public.
